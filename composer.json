{
    "name": "islesurlasorguetourisme/sulu-qrcode-bundle",
    "description": "Dynamic QR codes for Sulu 3: stable short URLs, editable targets, scan statistics and PNG/SVG rendering.",
    "type": "sulu-bundle",
    "license": "MIT",
    "keywords": [
        "sulu",
        "sulu-bundle",
        "sulucms",
        "symfony",
        "qrcode",
        "qr-code",
        "dynamic-qr-code"
    ],
    "homepage": "https://github.com/islesurlasorguetourisme/sulu-qrcode-bundle",
    "authors": [
        {
            "name": "Enzo Brigati"
        }
    ],
    "support": {
        "issues": "https://github.com/islesurlasorguetourisme/sulu-qrcode-bundle/issues",
        "source": "https://github.com/islesurlasorguetourisme/sulu-qrcode-bundle"
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "doctrine/dbal": "^3.9 || ^4.0",
        "doctrine/orm": "^2.17.3 || ^3.3",
        "endroid/qr-code": "^6.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "sulu/sulu": "^3.0",
        "symfony/config": "^6.4 || ^7.1 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.1 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.1 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.1 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.1 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.1 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.1 || ^8.0",
        "symfony/routing": "^6.4 || ^7.1 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.1 || ^8.0",
        "symfony/string": "^6.4 || ^7.1 || ^8.0",
        "symfony/translation-contracts": "^2.5 || ^3.0",
        "symfony/uid": "^6.4 || ^7.1 || ^8.0"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.58",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.1 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Islesurlasorguetourisme\\SuluQrCodeBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Islesurlasorguetourisme\\SuluQrCodeBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "phpstan": "@php vendor/bin/phpstan analyse",
        "cs": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "@php vendor/bin/php-cs-fixer fix",
        "lint": [
            "@composer validate --strict",
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": false,
            "symfony/runtime": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
